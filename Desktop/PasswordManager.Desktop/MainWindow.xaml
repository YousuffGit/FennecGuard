<ui:FluentWindow x:Class="PasswordManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FennecGuard" 
        Icon="Assets/logo.ico"
        Height="740" 
        Width="1020"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar Title="" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                <Image Source="Assets/logo.ico" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="FennecGuard" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border x:Name="SetupPanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:Card Width="440" Padding="28">
                <StackPanel>
                    <Image Source="Assets/logo.ico" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <ui:TextBlock Text="Welcome to FennecGuard" FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <ui:TextBlock Text="Create a master password to initialize your vault." Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                    <ui:TextBlock Text="Master Password" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                    <ui:PasswordBox x:Name="SetupMasterPasswordBox" PlaceholderText="Create Master Password (min 8 chars)" Height="40" Margin="0,0,0,14" />

                    <ui:TextBlock Text="Confirm Master Password" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                    <ui:PasswordBox x:Name="SetupConfirmPasswordBox" PlaceholderText="Confirm Master Password" Height="40" Margin="0,0,0,24" />

                    <ui:Button Style="{StaticResource AccentActionButtonStyle}" Content="Initialize Vault" Height="40" HorizontalAlignment="Stretch" Margin="0,0,0,12" Click="OnInitializeVaultClicked" />
                    <TextBlock x:Name="SetupStatusText" Text="" Foreground="#D13438" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </ui:Card>
        </Border>

        <Grid x:Name="UnlockPanel" Grid.Row="1" Visibility="Visible" Margin="18">
            <StackPanel VerticalAlignment="Center">
                <Image Source="Assets/logo.ico" Width="36" Height="36" Margin="0,0,0,10" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <ui:TextBlock Text="FennecGuard" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                <ui:TextBlock Text="Vault locked" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />

                <ui:PasswordBox x:Name="UnlockPasswordBox" PlaceholderText="Master Password" Height="38" Margin="0,0,0,12" KeyDown="OnUnlockKeyDown" />
                <ui:Button x:Name="UnlockButton" Style="{StaticResource AccentActionButtonStyle}" Content="Unlock" Height="38" HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="OnUnlockClicked" />

                <TextBlock x:Name="UnlockStatusText" Text="" Foreground="#D13438" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" />
            </StackPanel>
        </Grid>

        <Grid x:Name="VaultPanel" Grid.Row="1" Visibility="Collapsed" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <ui:TextBlock Text="Vault Logins" FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource SecondaryActionButtonStyle}" Content="Settings" Margin="0,0,8,0" Click="OnSettingsClicked" />
                    <ui:Button Style="{StaticResource SecondaryActionButtonStyle}" Content="Lock Vault" Click="OnLockClicked" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <ui:TextBlock x:Name="EmptyVaultText" Text="No logins stored yet. Add your first credential below." 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Subtitle" 
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="VaultItemsContainer">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="15" Margin="0,0,0,3" />
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                                                <ui:TextBlock Text="  •  " Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" />
                                                <ui:TextBlock Text="{Binding WebsiteUrl}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Copy and Delete Action Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Style="{StaticResource SecondaryActionButtonStyle}" Content="Copy Password" Click="OnCopyPasswordClicked" Tag="{Binding}" Margin="0,0,8,0" />
                                            <ui:Button Style="{StaticResource DangerActionButtonStyle}" Content="Delete" Click="OnDeleteCredentialClicked" Tag="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <ui:Card Grid.Row="2" Padding="16">
                <StackPanel>
                    <ui:TextBlock Text="Add New Credential" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox x:Name="NewTitleBox" PlaceholderText="Title (e.g. GitHub)" Margin="0,0,8,0" Grid.Column="0" />
                        <ui:TextBox x:Name="NewUsernameBox" PlaceholderText="Username or Email" Margin="0,0,8,0" Grid.Column="1" />
                        <ui:TextBox x:Name="NewUrlBox" PlaceholderText="Website URL" Margin="0,0,8,0" Grid.Column="2" />
                        <ui:PasswordBox x:Name="NewPasswordBox" PlaceholderText="Password" Margin="0,0,8,0" Grid.Column="3" />

                        <ui:Button Style="{StaticResource AccentActionButtonStyle}" Content="Save" Grid.Column="4" Width="80" Click="OnAddCredentialClicked" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>

        <Grid x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <ui:Button Style="{StaticResource SecondaryActionButtonStyle}" Content="← Back to Vault" DockPanel.Dock="Left" Click="OnBackFromSettingsClicked" Margin="0,0,16,0" />
                <ui:TextBlock Text="Settings" FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                    
                    <ui:Card Margin="0,0,0,14" Padding="20">
                        <StackPanel>
                            <ui:TextBlock Text="Appearance" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBlock Text="Customize your color palette or sync with Windows system preferences." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SystemThemeRadio" Content="System Default" Checked="OnSystemThemeChecked" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,20,0" />
                                <RadioButton x:Name="DarkThemeRadio" Content="Dark Mode" Checked="OnDarkThemeChecked" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,20,0" />
                                <RadioButton x:Name="LightThemeRadio" Content="Light Mode" Checked="OnLightThemeChecked" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,14" Padding="20">
                        <StackPanel>
                            <ui:TextBlock Text="System &amp; Background" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBlock Text="Configure tray minimization, startup, and notification preferences." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left" MaxWidth="480">
                                    <ui:TextBlock Text="Minimize to System Tray" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBlock Text="Keeps FennecGuard accessible in the Windows notification area when minimized." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="MinimizeToTraySwitch" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnMinimizeToTrayToggled" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left" MaxWidth="480">
                                    <ui:TextBlock Text="Start at System Logon" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBlock Text="Automatically launch FennecGuard in the background when logging into Windows." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="StartAtLogonSwitch" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnStartAtLogonToggled" />
                            </DockPanel>

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="480">
                                    <ui:TextBlock Text="Clipboard Copy Notification" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBlock Text="Display a confirmation dialog when copying a password." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ClipboardNotificationSwitch" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnClipboardNotificationToggled" />
                            </DockPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,14" Padding="20">
                        <StackPanel>
                            <ui:TextBlock Text="Auto-Lock" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBlock Text="Automatically lock your vault and wipe session keys after inactivity." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Left" MaxWidth="480">
                                    <ui:TextBlock Text="Enable Auto-Lock" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <ui:TextBlock Text="Secures the vault and purges active memory after the configured period." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="AutoLockSwitch" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnAutoLockToggled" />
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:TextBlock Text="Lock vault after:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <ui:TextBox x:Name="AutoLockHoursBox" Width="64" Text="24" TextChanged="OnAutoLockHoursChanged" Margin="0,0,8,0" />
                                <ui:TextBlock Text="hour(s)" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,14" Padding="20">
                        <StackPanel>
                            <ui:TextBlock Text="Change Master Password" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBlock Text="Update your master password and re-encrypt the vault." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                            <ui:TextBlock Text="Current Master Password" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                            <ui:PasswordBox x:Name="ChangeCurrentPasswordBox" PlaceholderText="Enter Current Password" Height="38" Margin="0,0,0,12" />

                            <ui:TextBlock Text="New Master Password" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                            <ui:PasswordBox x:Name="ChangeNewPasswordBox" PlaceholderText="Enter New Password (min 8 chars)" Height="38" Margin="0,0,0,12" />

                            <ui:TextBlock Text="Confirm New Master Password" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                            <ui:PasswordBox x:Name="ChangeConfirmPasswordBox" PlaceholderText="Confirm New Password" Height="38" Margin="0,0,0,16" />

                            <ui:Button Style="{StaticResource AccentActionButtonStyle}" Content="Update Password" Height="38" Click="OnChangeMasterPasswordClicked" Margin="0,0,0,10" />
                            <TextBlock x:Name="ChangePasswordStatusText" Text="" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <ui:TextBlock Text="Security Specifications" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBlock Text="Cryptographic standards implemented in FennecGuard." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />

                            <ui:TextBlock Text="• Key Derivation: Argon2id (64 MB Memory, 3 Iterations, 4 Threads)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                            <ui:TextBlock Text="• Field Encryption: AES-256-GCM" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                            <ui:TextBlock Text="• Disk Encryption: SQLCipher 256-bit" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                            <ui:TextBlock Text="• Memory Protection: ZeroMemory, Pinned RAM, and Win32 VirtualLock" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="CopyNotificationOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Background="#66000000">
            <ui:Card Width="400" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ui:TextBlock Text="Password Copied" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
                    <ui:TextBlock Text="The password has been copied to your clipboard. For your security, it will automatically clear from your clipboard in 30 seconds." 
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" FontSize="13" />

                    <CheckBox x:Name="DontShowCopyNotificationCheck" Content="Don't show this notification again" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,18" />

                    <ui:Button Style="{StaticResource AccentActionButtonStyle}" Content="OK" HorizontalAlignment="Right" Width="90" Click="OnDismissCopyNotificationClicked" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
